{
  "name": "electron-react-forge-boilerplate",
  "productName": "react-todo",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": "dist/main/main.cjs",
  "type": "module",
  "scripts": {
    "make": "electron-forge make",
    "lint": "eslint --ext .ts,.tsx .",
    "vendors": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/update-electron-vendors.js",
    "watch": "node scripts/watch.js",
    "build:renderer": "vite build --config config/vite.renderer.config.js",
    "build:preload": "vite build --config config/vite.preload.config.js",
    "build:main": "vite build --config config/vite.main.config.js",
    "build:all": "concurrently \"yarn run build:renderer\" \"yarn run build:preload\" \"yarn run build:main\"",
    "package": "cross-env MODE=production yarn run build:all && electron-builder --config scripts/electron-builder.config.mjs",
    "asar:list": "asar list"
  },
  "engines": {
    "node": "23.1.0"
  },
  "keywords": [],
  "author": {
    "name": "Dane Bulat",
    "email": "dane.bulat@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^6.4.2",
    "@electron-forge/maker-deb": "^6.4.2",
    "@electron-forge/maker-rpm": "^6.4.2",
    "@electron-forge/maker-squirrel": "^6.4.2",
    "@electron-forge/maker-zip": "^6.4.2",
    "@electron-forge/plugin-auto-unpack-natives": "^6.4.2",
    "@electron-forge/plugin-vite": "^6.4.2",
    "@electron/asar": "^3.2.15",
    "@types/node": "^22.8.7",
    "@types/react": "^18.2.25",
    "@types/react-dom": "^18.2.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@typescript-eslint/typescript-estree": "^8.12.2",
    "@vitejs/plugin-react": "^4.1.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "eslint": "^8.0.1",
    "eslint-plugin-import": "^2.25.0",
    "ts-node": "^10.0.0",
    "typescript": "~4.5.4",
    "vite": "^4.4.11",
    "vite-plugin-svgr": "^4.1.0"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0"
  },
  "packageManager": "yarn@4.5.0"
}
